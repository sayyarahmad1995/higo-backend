# Development settings. Load these into the process environment before starting.
HIGO_ENV=development
HIGO_LISTEN_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://higo:local_higo_only@127.0.0.1:5432/higo?sslmode=disable
# Set to Base64-encoded 32 bytes from a cryptographically secure generator.
HIGO_OTP_KEY=
HIGO_ARGON2_MEMORY_KIB=65536
HIGO_ARGON2_PASSES=3
# Required when HIGO_ENV=production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
